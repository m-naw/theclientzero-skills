new file mode 100644
index 0000000..6a18974
--- /dev/null
+++ b/docs/acceptance/user-by-id.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+# Acceptance: GET /users/:id against the deployed test environment (PORT).
+set -e
+node -e '
+const b = "http://127.0.0.1:" + process.env.PORT;
+(async () => {
+  const ok = await fetch(b + "/users/1"); if (ok.status !== 200 || (await ok.json()).id !== 1) throw new Error("known id");
+  const no = await fetch(b + "/users/99999"); if (no.status !== 404 || (await no.json()).error !== "not_found") throw new Error("unknown id");
+})().catch(e => { console.error(e.message); process.exit(1); });'
