{
  "name": "skill-observability",
  "version": "0.1.0",
  "description": "Logs every Skill tool invocation to $CLAUDE_PROJECT_DIR/.claude/skill-invocations.jsonl. Diagnostic-only — never blocks tool calls.",
  "author": {
    "name": "m-naw",
    "email": "m-naw@users.noreply.github.com"
  },
  "repository": "https://github.com/m-naw/theclientzero-skills",
  "license": "MIT",
  "keywords": ["observability", "skills", "diagnostic", "hook"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-skill-call.sh"
          }
        ]
      }
    ]
  }
}
